# Copy to .env (git-ignored). Only OPENAI_API_KEY is required for local dev.
ENV=development
OPENAI_API_KEY=
DATABASE_URL=postgresql://blistro:blistro@localhost:55433/blistro_ai
# DB_POOLED=true            # behind Neon's pooler / PgBouncer

# Auth: "dev" trusts an X-Dev-User header (local and evals only; refused when ENV=production).
AUTH_MODE=dev
# KINDE_ISSUER_URL=https://<your-subdomain>.kinde.com
# KINDE_AUDIENCE=
# SERVICE_TOKEN=            # openssl rand -hex 32; same value as the Next.js app

# Retrieval
# ACTIVE_STRATEGY=recursive
# INGEST_STRATEGIES=["recursive"]
# RERANK_PROVIDER=cohere     # cohere | local | none
# COHERE_API_KEY=

# Langfuse Cloud (tracing, prompt management, experiments)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
